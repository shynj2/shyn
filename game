function openWindow() {
  const ph = PHASES[BOSS.phase];
  BOSS.state = 'window';
  BOSS.needle = 0; BOSS.dir = 1;
  BOSS.speed = ph.speed; BOSS.zoneW = ph.zone;
  BOSS.zoneA = .12 + Math.random() * .76;
  BOSS.pose = 'cast';
  BOSS.timer = 0;
  const t = el('timing');
  t.classList.remove('good', 'fail');
  t.classList.add('on');
  el('timingHint').textContent = ph.hint;
  el('timingRes').textContent = '';
  const z = el('timingZone');
  z.style.left = (BOSS.zoneA * 100) + '%';
  z.style.width = (BOSS.zoneW * 100) + '%';
  Sound.rune();
}

function spawnOrb() {
  const groundY = World.groundNear(P.x + P.w / 2);
  let tx = clamp(P.x + P.w / 2 + (Math.random() - .5) * 160, 53, ZONES.arena.w - 53);
  BOSS.orbs.push({ x: tx, y: G.camY - 27, vy: 440, ground: groundY, done: false, t: 0 });
  Sound.orb();
}

function hitBossPlayer(x) {
  if (P.hurt > 0) return;
  P.hurt = .45;
  BOSS.hurtFlash = .3;
  G.shake = 7;
  Sound.hit();
  setDet(G.det - 1);
  burst(x, P.y + 16, 'rgba(255,90,120,', 14, 90);
  if (G.det <= 0) bossDeath();
}

function bossUpdate(dt) {
  const ph = PHASES[BOSS.phase];
  BOSS.timer += dt;
  if (BOSS.hurtFlash > 0) BOSS.hurtFlash -= dt;
  // orbs
  for (let i = BOSS.orbs.length - 1; i >= 0; i--) {
    const o = BOSS.orbs[i]; if (!o) continue;
    o.y += o.vy * dt;
    o.t += dt;
    if (o.y >= o.ground - 13) {
      burst(o.x, o.ground - 6, 'rgba(190,140,255,', 16, 90);
      burst(o.x, o.ground - 4, 'rgba(255,220,180,', 8, 60);
      G.shake = Math.max(G.shake, 4);
      Sound.land();
      // hit test: player must be airborne / away
      const dx = Math.abs((P.x + P.w / 2) - o.x);
      const lowToGround = (P.y + P.h) > o.ground - 27;
      if (dx < 23 && lowToGround) hitBossPlayer(o.x);
      // that hit may have ended the fight (bossDeath empties BOSS.orbs). In the third phase two orbs land in the
      // same frame, and reading the second one from the emptied list used to stop the whole game loop.
      if (!BOSS.active) return;
      BOSS.orbs.splice(i, 1);
    }
  }
  if (BOSS.state === 'intro') {
    if (BOSS.timer > .9) beginVolley();
  } else if (BOSS.state === 'volley') {
    BOSS.volleyT += dt;
    if (BOSS.volleyN < ph.orbs && BOSS.volleyT > ph.gap) {
      BOSS.volleyT = 0; BOSS.volleyN++;
      spawnOrb();
      if (ph.pair && BOSS.volleyN % 2 === 0) spawnOrb();
    }
    if (BOSS.volleyN >= ph.orbs && BOSS.orbs.length === 0 && BOSS.volleyT > .55) openWindow();
  } else if (BOSS.state === 'window') {
    BOSS.needle += BOSS.dir * BOSS.speed * dt;
    if (BOSS.needle > 1) { BOSS.needle = 1; BOSS.dir = -1; }
    if (BOSS.needle < 0) { BOSS.needle = 0; BOSS.dir = 1; }
    el('timingNeedle').style.left = 'calc(' + (BOSS.needle * 100) + '% - .1em)';
    if (BOSS.timer > ph.time) {
      el('timing').classList.remove('on');
      BOSS.state = 'resolve'; BOSS.timer = 0;
      BOSS.pose = 'idle';
      hitBossPlayer(P.x + P.w / 2);
    }
  } else if (BOSS.state === 'resolve') {
    if (BOSS.timer > .8) {
      if (BOSS.hitsDone >= TOTAL_HITS) {
        BOSS.state = 'done';
        mercyScene();
      } else if (BOSS.hitsDone >= PHASES.slice(0, BOSS.phase + 1).reduce((a, p) => a + p.need, 0)) {
        BOSS.phase++;
        BOSS.state = 'phaseout'; BOSS.timer = 0;
        bossSync();
        BOSS.pose = 'idle';
        Dlg.open(DC[PHASES[BOSS.phase].dlg], () => {
          G.scene = 'boss'; beginVolley();
        });
      } else {
        beginVolley();
      }
    }
  }
}

function bossStrike() {
  if (BOSS.state !== 'window') return;
  const inside = Math.abs(BOSS.needle - (BOSS.zoneA + BOSS.zoneW / 2)) <= BOSS.zoneW / 2;
  const t = el('timing');
  if (inside) {
    BOSS.state = 'resolve'; BOSS.timer = 0;
    BOSS.hitsDone++;
    bossSync();
    t.classList.add('good');
    el('timingRes').textContent = 'Rune shattered';
    Sound.rune();
    G.flash = .6; G.flashColor = 'rgba(200,160,255,';
    G.shake = 9;
    BOSS.pose = 'hurt';
    BOSS.orbs.length = 0;
    burst(BOSS.x, World.groundNear(BOSS.x) - 60, 'rgba(220,170,255,', 26, 150);
    setTimeout(() => { BOSS.pose = 'idle'; }, 500);
    setTimeout(() => { t.classList.remove('on', 'good'); }, 700);
  } else {
    BOSS.state = 'resolve'; BOSS.timer = 0;
    t.classList.add('fail');
    el('timingRes').textContent = 'The rune holds';
    Sound.hit();
    hitBossPlayer(P.x + P.w / 2);
    setTimeout(() => { t.classList.remove('on', 'fail'); }, 700);
  }
}

function bossDeath() {
