    if (!ctx) return;
    const m = MOODS[mood] || MOODS.workshop;
    const t = now();
    if (amb) { // fade out the old bed
      const old = amb;
      old.g.gain.cancelScheduledValues(t);
      old.g.gain.setValueAtTime(old.g.gain.value, t);
      old.g.gain.exponentialRampToValueAtTime(0.0001, t + 1.4);
