    const heat = (typeof BOSS !== 'undefined' && BOSS.active) ? BOSS.phase + 1 : 0;
    if (nextT < c.currentTime) nextT = c.currentTime + .06;
    while (nextT < c.currentTime + .4) {
      const t = nextT, bar = step % 16, cd = z.ch[Math.floor(step / 16) % z.ch.length];
      if (bar === 0) {                                                            // a new chord: bass and pad swell in
        const L = sp * 16;
        voice(hz(z, cd, -1), t, L * 1.05, 'sine', .2, 1.2);
        for (let i = 0; i < 3; i++) voice(hz(z, cd + i * 2, 0) * (1 + (i - 1) * .003), t + i * .09, L * 1.1, z.wave, z.wave === 'sawtooth' ? .034 : .065, 2.2, z.cut);
        if (z.organ) voice(hz(z, cd + 4, 1), t, L, 'sine', .028, 3);
      }
      if (z.pulse) {                                                              // the Throne: a low drum-like ostinato
        voice(hz(z, cd, -1), t, sp * .9, 'sawtooth', step % 4 === 0 ? .13 : .06, .005, 260 + heat * 170);
        if (heat >= 2) voice(hz(z, cd, 0), t + sp / 2, sp * .45, 'sawtooth', .04, .004, 500 + heat * 200);
        if (step % 8 === 0) voice(hz(z, cd, -2), t, .5, 'sine', .3, .004);
        if (heat >= 3 && step % 8 === 6) voice(hz(z, cd + 1, 1), t, .3, 'square', .025, .004, 1400);
      }
      if (z.pizz && step % 2 === 0) voice(hz(z, cd + [0, 2, 4, 2][(step / 2) % 4], 0), t, .24, 'triangle', .09, .005);
