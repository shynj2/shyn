  let cur = null, bus = null, step = 0, nextT = 0, rnd = Math.random, walk = 3, started = false;

  function setup() {
    const c = Sound.ctx; if (!c || !Sound.out) return false;
    if (bus) return true;
    bus = c.createGain(); bus.gain.value = 0;
    const lp = c.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 2600;
    const dly = c.createDelay(1.5), fb = c.createGain(), wet = c.createGain();
    dly.delayTime.value = .42; fb.gain.value = .38; wet.gain.value = .34;
