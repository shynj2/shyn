<body>
<div id="app">
<div id="stage">
  <canvas id="cv" width="640" height="360"></canvas>

  <div class="hud">
    <div class="nameplate">
      <b id="hudName">ARASH</b>
      <i>Seeker Of Talent</i>
      <em id="hudObj"></em>
    </div>
    <div class="score">Score <b id="hudScore">0</b></div>
    <div class="det" id="hudDet"></div>
  </div>

  <div id="prompt"><kbd>E</kbd><span id="promptTxt"></span></div>

  <div id="dlg">
    <div class="inner">
      <canvas class="por" id="dlgPor" width="46" height="46"></canvas>
      <div>
        <div class="head"><span class="who" id="dlgWho"></span></div>
        <div class="txt" id="dlgTxt"></div>
        <div class="choices" id="dlgChoices"></div>
      </div>
    </div>
    <div class="next" id="dlgNext">▼</div>
  </div>

  <div id="zonecard"><div class="in">
    <div class="zt" id="ztTitle"></div>
    <div class="rule"></div>
    <div class="zs" id="ztSub"></div>
  </div></div>

  <div id="toast"><span class="ic">✦</span><span class="t"></span><span class="s"></span></div>

  <div id="fight">
    <div class="bossbar">
      <div class="bn">Shyn — Keeper of the Root Code</div>
      <div class="track"><div class="fill" id="bossFill"></div></div>
      <div class="pips" id="bossPips"></div>
    </div>
    <div class="timing" id="timing">
      <div class="hint" id="timingHint">Shatter the rune</div>
      <div class="track"><div class="zone" id="timingZone"></div><div class="needle" id="timingNeedle"></div></div>
      <div class="res" id="timingRes"></div>
    </div>
    <div class="keyhint"><kbd>E</kbd> shatter &nbsp;·&nbsp; <kbd>←</kbd><kbd>→</kbd> move</div>
  </div>

  <div class="ov" id="intro">
    <div class="center">
      <div class="lines" id="introLines"></div>
      <form id="nameform" autocomplete="off">
        <label for="pn">Enter your name, Recruiter.</label>
        <input id="pn" maxlength="14" placeholder="ARASH" autocomplete="off" spellcheck="false">
        <button class="btn pri" type="submit">Begin</button>
      </form>
    </div>
  </div>

  <div class="ov" id="codex">
    <div class="book">
      <div class="spine"></div>
      <nav id="chapNav"><div class="title">Codex</div></nav>
      <div class="page" id="codexPage"></div>
    </div>
    <button class="btn codex-close" id="codexClose">Close ✦ Esc</button>
  </div>

  <div class="ov" id="pause">
    <div class="center">
      <h2>Veyrath is still</h2>
      <div class="menu">
        <button class="btn" data-act="codex">Codex</button>
        <button class="btn" data-act="ach">Achievements</button>
        <button class="btn" data-act="continue">Continue Journey</button>
        <button class="btn" data-act="leave">Leave Veyrath</button>
      </div>
      <div class="foot">Esc — return</div>
    </div>
  </div>

  <div class="ov" id="attempt">
    <div class="center">
      <div class="n">Attempt</div>
      <div class="num" id="attNum">#1</div>
      <div class="l1" id="attL1"></div>
      <div class="l2" id="attL2"></div>
      <div class="ret" id="attRet">Press E to return</div>
    </div>
  </div>

  <div class="ov" id="ending">
    <div class="center">
      <div class="fin" id="endFin"></div>
      <div class="sig">Veyrath · The Rune Architect</div>
    </div>
  </div>

  <div id="touch">
    <div class="dpad">
      <button data-dir="left">◀</button>
      <button data-dir="right">▶</button>
    </div>
    <div class="right">
      <button class="jmp" data-act="jump">▲</button>
      <button data-act="act">✦</button>
    </div>
  </div>

  <button id="mute" title="Sound (M)" aria-label="Toggle sound">♪</button>
  <button id="menuBtn" title="Menu (Esc)" aria-label="Open menu">☰</button>
  <div id="hintPortrait">Rotate for the full view</div>
</div>
</div>

