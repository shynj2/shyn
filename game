  },
  /** tile code at a tile coordinate; outside the map: walls at the sides and top, void below */
  at(tx, ty) { const m = this.m; if (tx < 0 || tx >= m.w || ty < 0) return T_SOLID; if (ty >= m.h) return T_AIR;
    const c = m.t[ty * m.w + tx];
