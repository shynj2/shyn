    forest:     { root: -7,  sc: DOR, ch: [0, 3, 6, 4],       bpm: 72,  wave: 'sine',     cut: 1500, bell: .75 },
    cathedral:  { root: -12, sc: MIN, ch: [0, 3, 5, 4],       bpm: 54,  wave: 'sawtooth', cut: 700,  bell: .4, organ: 1 },
    catacombs:  { root: -11, sc: PHR, ch: [0, 1, 0, 6],       bpm: 60,  wave: 'triangle', cut: 600,  bell: .3 },
    repository: { root: -9,  sc: MIN, ch: [0, 5, 3, 4],       bpm: 58,  wave: 'sine',     cut: 1100, bell: .65 },
    arena:      { root: -14, sc: PHR, ch: [0, 0, 1, 0, 5, 1], bpm: 92,  wave: 'sawtooth', cut: 800,  bell: .22, pulse: 1 },
    room499:    { root: -5,  sc: MAJ, ch: [0, 3, 4, 0],       bpm: 104, wave: 'triangle', cut: 1800, bell: .7, pizz: 1 }
