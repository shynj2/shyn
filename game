    lfo.frequency.value = 0.055; lg.gain.value = m.cut * 0.35;
    lfo.connect(lg); lg.connect(f.frequency);
    o1.connect(o1g); o1g.connect(f); o2.connect(f); f.connect(g); g.connect(master);
    o1.start(t); o2.start(t); lfo.start(t);
