const PHASES = [   // need = runes to shatter, orbs per volley, gap = seconds between orbs, time = seconds the needle stays, zone = width of the sweet spot
  { need: 2, orbs: 3, gap: .8,  time: 8, speed: 1.0,  zone: .22, dlg: 'shyn_p1', hint: 'Shatter the prototype' },
  { need: 3, orbs: 5, gap: .62, time: 7, speed: 1.4,  zone: .17, dlg: 'shyn_p2', hint: 'Shatter the revision' },
  { need: 3, orbs: 6, gap: .5,  time: 6, speed: 1.85, zone: .13, pair: true, dlg: 'shyn_p3', hint: 'Shatter the root rune' }
];
const TOTAL_HITS = PHASES.reduce((a, p) => a + p.need, 0);

const BOSS = {
  active: false, phase: 0, hitsDone: 0, state: 'idle',
  x: 560, pose: 'idle', timer: 0, orbs: [],
  volleyN: 0, volleyT: 0, needle: 0, dir: 1, speed: .85, zoneA: .4, zoneW: .2,
  hurtFlash: 0, dead: false
