        if (h < .05) blit('deco_crack', (h * 997) | 0, tx * TILE, ty * TILE);
        else if (h < .075 && isWall(this.at(tx, ty + 1))) blit('deco_stain', (h * 613) | 0, tx * TILE, ty * TILE);
        else if (h > .994) blit('deco_plate', 0, tx * TILE, ty * TILE);
        else if (h > .982) blit('deco_sigil', (h * 7919) | 0, tx * TILE, ty * TILE);
      }
    }
    // wall head and wall ends: a lit coping where the masonry stops against open air
    for (let j = -1; j <= n; j++) for (let i = -1; i <= n; i++) {
      const tx = tx0 + i, ty = ty0 + j, c = this.at(tx, ty);
      if (c !== T_WALL && c !== T_PLAT) continue;
      const x = tx * TILE - ox, y = ty * TILE - oy, open = (t) => t === T_AIR || t === T_PLAT_OPEN;
      if (open(this.at(tx, ty - 1))) { g.fillStyle = A.css[ART.names.soot3]; g.fillRect(x, y, TILE, 2); g.fillStyle = A.css[ART.names.soot4]; if (hash2(tx, ty, 4) > .5) g.fillRect(x + 3, y, 7, 1); g.fillStyle = A.css[ART.names.void2]; g.fillRect(x, y + 2, TILE, 1); g.fillRect(x + ((hash2(tx, ty, 6) * 14) | 0), y, 1, 2); }
      if (open(this.at(tx - 1, ty))) { g.fillStyle = A.css[ART.names.soot3]; g.fillRect(x, y, 2, TILE); g.fillStyle = A.css[ART.names.void2]; g.fillRect(x + 2, y, 1, TILE); }
      if (open(this.at(tx + 1, ty))) { g.fillStyle = A.css[ART.names.soot2]; g.fillRect(x + TILE - 2, y, 2, TILE); g.fillStyle = A.css[ART.names.void2]; g.fillRect(x + TILE - 3, y, 1, TILE); }
    }
    // 2 · openings cut through the wall (arches onto the far hall), then back props
    g.globalCompositeOperation = 'destination-out';
    for (const it of this.cuts) if (inChunk(it)) { const r = sprRect(it.s, 0); g.drawImage(A.col, r[0], r[1], r[2], r[3], it.x - ox, it.y - oy, r[2], r[3]); }
    g.globalCompositeOperation = 'source-over';
    for (const it of this.stat) if (it.layer === 'back' && inChunk(it)) blit(it.s, it.frame, it.x, it.y);
    // 3 · solids, autotiled: interior texture by position + edge overlays from the neighbours
    for (let j = -1; j <= n; j++) for (let i = -1; i <= n; i++) {
      const tx = tx0 + i, ty = ty0 + j, c = this.at(tx, ty), x = tx * TILE, y = ty * TILE;
      if (c === T_SOLID) {
        const U = this.solid(tx, ty - 1), D = this.solid(tx, ty + 1) || ty + 1 >= this.m.h, Lf = this.solid(tx - 1, ty), Rt = this.solid(tx + 1, ty);
        const deep = U && D && Lf && Rt && this.solid(tx, ty - 2) && (this.solid(tx, ty + 2) || ty + 2 >= this.m.h) && this.solid(tx - 2, ty) && this.solid(tx + 2, ty) && this.solid(tx - 1, ty - 1) && this.solid(tx + 1, ty - 1);
        piece(deep ? 'sol_deep' : 'sol_in', tx, ty);
        const h = hash2(tx, ty, 5);
        if (!D) blit('sol_bot', (h * 2) | 0, x, y);
        if (!Lf) blit('sol_l', (h * 4) & 1, x, y);
        if (!Rt) blit('sol_r', (h * 8) & 1, x, y);
        if (!U) blit('sol_top', (h * 5) | 0, x, y);
      } else if (c === T_PLAT || c === T_PLAT_OPEN) {
        const pl = (t) => t === T_PLAT || t === T_PLAT_OPEN, l = pl(this.at(tx - 1, ty)) || this.solid(tx - 1, ty), r = pl(this.at(tx + 1, ty)) || this.solid(tx + 1, ty);
        blit(!l ? 'plat_l' : !r ? 'plat_r' : 'plat_m', (hash2(tx, ty, 2) * 2) | 0, x, y);
      }
    }
    // 4 · props in front of the masonry
    for (const it of this.stat) if (it.layer !== 'back' && inChunk(it)) blit(it.s, it.frame, it.x, it.y);
    return { col, emi: hasE ? emi : null };
  }
};

/* ---------------- lights: banded, dithered discs, pre-baked once per radius+colour ---------------- */
const Lights = {
  cache: {},
  sprite(r, cname) {
    const key = r + cname; let c = this.cache[key];
    if (c) return c;
    const col = LIGHT_COL[cname] || LIGHT_COL.fire, S = r * 2;
    c = mk(S, S); const g = c.getContext('2d'), id = g.createImageData(S, S), o = id.data, BANDS = 6;
    for (let y = 0; y < S; y++) for (let x = 0; x < S; x++) {
      const dx = x + .5 - r, dy = (y + .5 - r) * 1.12, d = Math.sqrt(dx * dx + dy * dy) / r;
      if (d >= 1) continue;
      const q = (1 - d) * BANDS, b = (B4[(y & 3) * 4 + (x & 3)] + .5) / 16;
      const lv = Math.min(BANDS, Math.floor(q + (b - .5) * .4 + .5)), k = Math.pow(lv / BANDS, 1.25), i = (y * S + x) * 4;
      o[i] = col[0] * k; o[i + 1] = col[1] * k; o[i + 2] = col[2] * k; o[i + 3] = 255;
    }
    g.putImageData(id, 0, 0);
    return (this.cache[key] = c);
  }
};

/* ===== 46-puzzle.js ===== */
/* ==========================================================================
   PUZZLES — sleeping rune platforms and the switches that wake them.

   In a map file the digits 1-9 are "sleeping" one-way platforms: air until their group wakes.
   A zone says which flag wakes which group:
       puzzle: { 1: 'pz_forest', 2: '!pz_repo' }       // '!' = awake while the flag is NOT set
   and places switches among its props:
       { t: 'switch', at: [col, row], id: 'pz_forest', label: 'Wake the rune' }          press once
       { t: 'switch', ..., id: 'pz_repo', toggle: true, tag: 'BRANCH' }                  flips each press
       { t: 'switch', ..., id: 'pz_m_role', of: 'pz_machine', step: 0, total: 3, tag: 'ROLE' }
                                   pressed in order 0,1,2 they set the flag 'pz_machine'; a wrong one resets the row
   Flags live in G.flags, so they are saved with the game.
   ========================================================================== */
const T_PHASE = 6;
const Puzzle = {
  hintT: 0,
  awake(g) {
    const pz = World.z && World.z.puzzle, f = pz && pz[g];
    if (!f) return false;
    return f[0] === '!' ? !G.flags[f.slice(1)] : !!G.flags[f];
  },
  lit(p) {
    if (p.of) return !!G.flags[p.of] || (G.flags[p.of + '_n'] | 0) > p.step;
    return !!G.flags[p.id];
  },
  /** true while this zone still has something asleep that a switch could wake */
  unsolved() { return (ZONES[G.zone].props || []).some((p) => p.t === 'switch' && !p.toggle && !Puzzle.lit(p)); },
  press(p) {
    const cx = p.x, cy = p.gy - 18;
    if (p.toggle) {
      G.flags[p.id] = !G.flags[p.id];
      Sound.rune(); G.shake = Math.max(G.shake, 3); burst(cx, cy, 'rgba(190,150,255,', 14, 70);
      toast('⎇', G.flags[p.id] ? 'Branch switched' : 'Back on the first branch', 'One path sleeps. The other wakes.', 4200);
    } else if (p.of) {
      if (G.flags[p.of]) return;
      const n = G.flags[p.of + '_n'] | 0;
      if (p.step < n) return;
      if (p.step === n) {
        G.flags[p.of + '_n'] = n + 1;
        Sound.open(); burst(cx, cy, 'rgba(150,220,255,', 12, 60);
        if (n + 1 >= p.total) { G.flags[p.of] = true; Sound.rune(); G.shake = Math.max(G.shake, 4); toast('✦', 'The machine understood', 'The bridge wakes.', 5200); }
      } else {
        G.flags[p.of + '_n'] = 0;
        Sound.hit(); G.shake = Math.max(G.shake, 3); P.hurt = .2;
        toast('✕', 'The machine misunderstood', 'Order matters. Begin again.', 5200);
      }
    } else {
      if (G.flags[p.id]) return;
      G.flags[p.id] = true;
      Sound.rune(); G.shake = Math.max(G.shake, 4); burst(cx, cy, 'rgba(190,150,255,', 18, 80);
      toast('✦', 'A rune wakes', p.woke || 'Sleeping stone remembers its shape.', 5200);
    }
    save();
  },
  /** called when the player falls into the void */
  fell() {
    if (G.time - this.hintT < 9 || !this.unsolved()) return;
    this.hintT = G.time;
    toast('◇', 'The way is asleep', ZONES[G.zone].puzzleHint || 'Find the rune that wakes it.', 5200);
  },
  /** sleeping / woken platforms and the switches, drawn every frame (they change, so they are not baked) */
  draw(g, cx, cy, t, emissive) {
    const ph = World.m.ph;
    for (let i = 0; i < ph.length; i++) {
      const c = ph[i], x = c.tx * TILE - cx, y = c.ty * TILE - cy;
      if (x < -16 || x > VW || y < -16 || y > VH) continue;
      const on = this.awake(c.g);
      if (emissive) { if (on) sprE(g, 'plat_rune', x, y, 1 + ((c.tx + ((t * 3) | 0)) % 2)); else if (((t * 2 + c.tx * .5) | 0) % 4 === 0) sprE(g, 'plat_rune', x, y, 0); }
      else spr(g, 'plat_rune', x, y, on ? 1 + ((c.tx + ((t * 3) | 0)) % 2) : 0);
    }
    const ps = World.z.props;
    for (let i = 0; i < ps.length; i++) {
      const p = ps[i]; if (p.t !== 'switch' || p.x - cx < -40 || p.x - cx > VW + 40) continue;
      const lit = this.lit(p), f = lit ? 1 : ((t * 2) | 0) % 2 ? 0 : 2;
      (emissive ? sprE : spr)(g, 'rune_switch', p.x - 8 - cx, p.gy - 28 - cy, f);
      if (p.tag && !emissive) { if (!p._tag) p._tag = pixText(p.tag, '#cdbcff', '#0b0714'); g.drawImage(p._tag, Math.round(p.x - cx - (p._tag.width >> 1)), p.gy - 40 - cy); }
      if (p.light) p.light.c = lit ? 'rune' : 'warm';
    }
  }
};

/* ===== 49-zones.js ===== */
/* ==========================================================================
   ZONES 2-7 — owner-editable, same format as the Workshop in 50-zones.js.
     at: [col, row]   col = tile column, row = the floor tile the thing stands on
     x:  pixels       (the two small rooms still use the old pixel positions)
   Ids, dialogue keys, door targets and lock rules are the frozen script. Do not rename them.
   Maps: art-src/maps/<map>.txt. Run `node tools/reach.mjs` after editing a map: it lists
   every platform the Recruiter cannot actually jump onto.
   ========================================================================== */
const range = (a, b, step = 1) => { const o = []; for (let i = a; i <= b; i += step) o.push(i); return o; };

/* ---------------- Frontend Forest helpers ---------------- */
const FG = 29;                                                // forest: row of the forest floor
// a great tree whose branches are the '-' platforms of the map; col = the column its trunk stands on
