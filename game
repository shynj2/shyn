let LANG = 'en';
try { LANG = localStorage.getItem('rune-architect-lang') === 'fa' ? 'fa' : 'en'; } catch (e) {}

/* English in, Persian out (or the same text when there is no translation / the language is English) */
function tr(s) {
  if (LANG !== 'fa' || typeof s !== 'string') return s;
  const k = s.trim(); if (!k) return s;
  if (FA[k]) return s.replace(k, FA[k]);
  let m;
  if ((m = /^Speak with (.+)$/.exec(k))) return 'گفت‌وگو با ' + (FA[m[1]] || m[1]);
  if ((m = /^Enter (.+)$/.exec(k))) return 'ورود به ' + (FA[m[1]] || m[1]);
  if ((m = /^(.+) ⛓$/.exec(k)) && FA[m[1]]) return FA[m[1]] + ' ⛓';
  return s;
}

/* the page translates itself: whenever the game writes English text into the UI, it is swapped here */
const I18N = {
  skip: '[data-noi18n],script,style,#dlgTxt,input,textarea',
  node(n) {
    if (LANG !== 'fa') return;
    const p = n.parentElement; if (!p || p.closest(this.skip)) return;
    const t = n.nodeValue, r = tr(t);
    if (r !== t) { n.__en = t; n.nodeValue = r; }
  },
  each(root, fn) { const w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT), all = []; let n; while ((n = w.nextNode())) all.push(n); all.forEach(fn); },
  walk(root) { this.each(root, (n) => this.node(n)); },
  restore(root) { this.each(root, (n) => { if (n.__en != null) { n.nodeValue = n.__en; n.__en = null; } }); }
};
new MutationObserver((ms) => {
  if (LANG !== 'fa') return;
  for (const m of ms) {
    if (m.type === 'characterData') I18N.node(m.target);
    else m.addedNodes.forEach((n) => { if (n.nodeType === 3) I18N.node(n); else if (n.nodeType === 1) I18N.walk(n); });
  }
}).observe(el('app'), { subtree: true, childList: true, characterData: true });

function setLang(l) {
  LANG = l === 'fa' ? 'fa' : 'en';
  try { localStorage.setItem('rune-architect-lang', LANG); } catch (e) {}
  document.documentElement.lang = LANG;
  el('stage').classList.toggle('fa', LANG === 'fa');
  if (LANG === 'fa') I18N.walk(el('app')); else I18N.restore(el('app'));
  if (typeof hudSync === 'function' && G.name) hudSync();
  document.dispatchEvent(new Event('langchange'));
}
/* the Codex pages switch language as whole pages */
for (const k in CODEX) {
  const en = CODEX[k].render, enL = CODEX[k].lockedRender;
  CODEX[k].render = () => (LANG === 'fa' && CODEX_FA[k] ? CODEX_FA[k]() : en());
  if (enL) CODEX[k].lockedRender = () => (LANG === 'fa' && CODEX_FA[k + 'Locked'] ? CODEX_FA[k + 'Locked']() : enL());
}

/* ===== 62-secret.js ===== */
/* ==========================================================================
   DEATHS and the one hidden achievement.
   A death is a fall into the void or a defeat at the Throne. On death number
   Secret.at the hidden title is written across the screen, once. Before that it
   is listed nowhere: not in the Achievements page, not in the tally, and its
   name is stored as shifted character codes so it cannot be found by searching
   the file. After that it appears as one extra row on the Achievements page.
   ========================================================================== */
const Secret = {
  at: 30,
  w: (a) => String.fromCharCode.apply(null, a.map((c) => c - 7)),
  en: [82, 86, 90, 82, 79, 86, 83],
  fa: [1712, 1596, 1589, 1611],
  n() { return LANG === 'fa' ? String(this.at).replace(/\d/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[d]) : String(this.at); },
  title() { return this.w(LANG === 'fa' ? this.fa : this.en); },
  show() {
    const d = document.createElement('div'); d.id = 'secret'; d.setAttribute('data-noi18n', '');
    d.innerHTML = '<b></b><i></i>';
    d.firstChild.textContent = this.title();
    d.lastChild.textContent = LANG === 'fa' ? 'دستاورد پنهان · ' + this.n() + ' بار مردن' : 'Hidden achievement · ' + this.n() + ' deaths';
    el('stage').appendChild(d);
    Sound.ach();
    requestAnimationFrame(() => requestAnimationFrame(() => d.classList.add('on')));
    setTimeout(() => d.classList.remove('on'), 6500);
    setTimeout(() => d.remove(), 7400);
  },
  /* the extra row on the Achievements page, only once it is earned */
  row(body) {
    if (!G.flags.s30) return;
    const r = document.createElement('div'); r.className = 'artifact'; r.setAttribute('data-noi18n', '');
    r.innerHTML = '<b></b><span></span>';
    r.firstChild.textContent = '☠ ' + this.title();
    r.lastChild.textContent = LANG === 'fa' ? this.n() + ' بار مردی. هنوز اینجایی.' : this.n() + ' deaths. Still here.';
    const h3 = body.querySelector('h3'); body.insertBefore(r, h3);
  }
};
function countDeath() {
  G.flags.deaths_n = (G.flags.deaths_n || 0) + 1;
  if (G.flags.deaths_n >= Secret.at && !G.flags.s30) { G.flags.s30 = true; Secret.show(); }
  save();
}

