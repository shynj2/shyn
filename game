/* ==========================================================================
   MUSIC — a generative score, synthesised live (no audio files).
   One slow piece per zone: bass + pad chords, a sparse bell melody that wanders
   over the scale, and a war pulse in the Throne that climbs with each phase.
   To retune a zone, edit its row in SCORE.
   ========================================================================== */
const Music = (() => {
